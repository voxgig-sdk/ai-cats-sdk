# BasicCatImageFlow

main: kit: flow: BasicCatImageFlow:
{
  entity: "cat_image",
  kind: "basic",
  name: "BasicCatImageFlow",
  step: [
    {
      i: {
        ref: "cat_image_ref01",
        srcdatavar: "cat_image_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-cat_image_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCatImageFlow"
}