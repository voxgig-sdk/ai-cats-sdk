# Entity: cat

main: kit: entity: cat: {

  alias: field: {}

  fields: [
    {
      format: "date-time"
      name: "createdAt"
      req: false
      short: "Timestamp when the image was generated"
      type: "`$STRING`"
    }
    {
      name: "height"
      req: false
      short: "Height of the image in pixels"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the cat image"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "URL of the AI-generated cat image"
      type: "`$STRING`"
    }
    {
      name: "width"
      req: false
      short: "Width of the image in pixels"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "cat"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cats/{id}"
          segments: [
            {
              lit: "cats"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
