# Entity: health

main: kit: entity: health: {

  alias: field: {}

  fields: [
    {
      name: "activityLevel"
      req: false
      short: "Activity level of the cat"
      type: "`$STRING`"
    }
    {
      name: "catId"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "ID of the cat"
      type: "`$STRING`"
    }
    {
      name: "heartRate"
      req: false
      short: "Heart rate in beats per minute"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the health record"
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "temperature"
      req: false
      short: "Body temperature in Celsius"
      type: "`$NUMBER`"
    }
    {
      format: "date-time"
      name: "timestamp"
      req: false
      short: "When the health data was recorded"
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "weight"
      op: {
        create: {
          req: true
          type: "`$NUMBER`"
        }
      }
      req: false
      short: "Weight of the cat in kg"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "health"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/cats/health"
          segments: [
            {
              lit: "cats"
            }
            {
              lit: "health"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "cat_id"
                orig: "cat_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/cats/health"
          segments: [
            {
              lit: "cats"
            }
            {
              lit: "health"
            }
          ]
          select: {
            exist: [
              "cat_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
