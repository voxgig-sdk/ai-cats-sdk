# Entity: interaction

main: kit: entity: interaction: {

  alias: field: {}

  fields: [
    {
      name: "catId"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "ID of the cat"
      type: "`$STRING`"
    }
    {
      name: "duration"
      req: false
      short: "Duration of the interaction in minutes"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the interaction"
      type: "`$STRING`"
    }
    {
      name: "notes"
      req: false
      short: "Additional notes about the interaction"
      type: "`$STRING`"
    }
    {
      name: "quality"
      req: false
      short: "Quality rating of the interaction"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "timestamp"
      req: false
      short: "When the interaction occurred"
      type: "`$STRING`"
    }
    {
      name: "type"
      op: {
        list: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Type of interaction"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "interaction"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/interactions"
          segments: [
            {
              lit: "interactions"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "cat_id"
                orig: "cat_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "end_date"
                orig: "end_date"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "start_date"
                orig: "start_date"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/interactions"
          segments: [
            {
              lit: "interactions"
            }
          ]
          select: {
            exist: [
              "cat_id"
              "end_date"
              "start_date"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
